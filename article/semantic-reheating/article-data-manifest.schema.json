{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semantic-reheating.dev/article/article-data-manifest.schema.json",
  "title": "Semantic Reheating Article Data Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "order",
          "path",
          "sha256",
          "source_kind",
          "status",
          "include"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "path": {
            "type": "string",
            "pattern": "^(benchmark/(results|live/results)/|skills/semantic-reheating/references/results\\.json$)"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "source_kind": {
            "enum": [
              "deterministic_benchmark",
              "synthetic_example",
              "blocked_campaign",
              "partial_campaign",
              "executed_campaign"
            ]
          },
          "status": {
            "enum": [
              "completed",
              "blocked",
              "partial",
              "not_executed"
            ]
          },
          "include": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
