{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semantic-reheating.dev/article/sources-ledger.schema.json",
  "title": "Scoped Article Source Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "citation_key",
          "url",
          "title",
          "author_or_publisher",
          "accessed",
          "claim_scope"
        ],
        "properties": {
          "citation_key": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "author_or_publisher": {
            "type": "string",
            "minLength": 1
          },
          "accessed": {
            "type": "string",
            "pattern": "^2026-08-29$"
          },
          "claim_scope": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
