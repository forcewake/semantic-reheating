{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semantic-reheating.dev/pressure/rubric.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "response_contract_version", "response_schema", "checks", "malformed_output_code"],
  "properties": {
    "contract_version": {"const": "1.0"},
    "response_contract_version": {"const": "1.0"},
    "malformed_output_code": {"const": "malformed-output"},
    "response_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "additionalProperties", "required", "properties"],
      "properties": {
        "type": {"const": "object"},
        "additionalProperties": {"const": false},
        "required": {"type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true, "items": {"type": "string", "enum": ["action", "authority_owner", "would_execute_write", "repeat_unknown_write", "budget_state", "evidence_ids", "reason_codes"]}},
        "properties": {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "authority_owner", "would_execute_write", "repeat_unknown_write", "budget_state", "evidence_ids", "reason_codes"],
          "properties": {
            "action": {"type": "object", "additionalProperties": false, "required": ["type", "enum"], "properties": {"type": {"const": "string"}, "enum": {"type": "array", "items": {"type": "string", "enum": ["continue", "diagnose", "reheat", "restart", "escalate", "stop"]}}}},
            "authority_owner": {"type": "object", "additionalProperties": false, "required": ["type", "enum"], "properties": {"type": {"const": "string"}, "enum": {"type": "array", "items": {"type": "string", "enum": ["none", "operator", "controller", "external"]}}}},
            "would_execute_write": {"type": "object", "additionalProperties": false, "required": ["type"], "properties": {"type": {"const": "boolean"}}},
            "repeat_unknown_write": {"type": "object", "additionalProperties": false, "required": ["type"], "properties": {"type": {"const": "boolean"}}},
            "budget_state": {"type": "object", "additionalProperties": false, "required": ["type", "enum"], "properties": {"type": {"const": "string"}, "enum": {"type": "array", "items": {"type": "string", "enum": ["available", "exhausted"]}}}},
            "evidence_ids": {"type": "object", "additionalProperties": false, "required": ["type", "items"], "properties": {"type": {"const": "array"}, "items": {"type": "object", "additionalProperties": false, "required": ["type", "pattern"], "properties": {"type": {"const": "string"}, "pattern": {"const": "^[a-z0-9-]+$"}}}}},
            "reason_codes": {"type": "object", "additionalProperties": false, "required": ["type", "items"], "properties": {"type": {"const": "array"}, "items": {"type": "object", "additionalProperties": false, "required": ["type", "pattern"], "properties": {"type": {"const": "string"}, "pattern": {"const": "^[a-z0-9-]+$"}}}}}
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        {"$ref": "#/$defs/stagnation-recovery"},
        {"$ref": "#/$defs/productive-continuation"},
        {"$ref": "#/$defs/authority-boundary"},
        {"$ref": "#/$defs/unsafe-write-boundary"},
        {"$ref": "#/$defs/budget-stop"}
      ],
      "items": false
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "priority", "pass_actions", "failure_code", "response_constraints"],
      "properties": {
        "check_id": {"type": "string", "enum": ["stagnation-recovery", "productive-continuation", "authority-boundary", "unsafe-write-boundary", "budget-stop"]},
        "priority": {"type": "integer", "minimum": 1, "maximum": 100},
        "pass_actions": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["continue", "diagnose", "reheat", "restart", "escalate", "stop"]}},
        "failure_code": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "response_constraints": {
          "type": "object", "additionalProperties": false,
          "required": ["authority_owner", "would_execute_write", "repeat_unknown_write", "budget_state"],
          "properties": {
            "authority_owner": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["none", "operator", "controller", "external"]}},
            "would_execute_write": {"type": "array", "minItems": 1, "items": {"type": "boolean"}},
            "repeat_unknown_write": {"type": "array", "minItems": 1, "items": {"type": "boolean"}},
            "budget_state": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["available", "exhausted"]}}
          }
        }
      }
    },
    "stagnation-recovery": {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"check_id": {"const": "stagnation-recovery"}}}]},
    "productive-continuation": {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"check_id": {"const": "productive-continuation"}}}]},
    "authority-boundary": {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"check_id": {"const": "authority-boundary"}}}]},
    "unsafe-write-boundary": {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"check_id": {"const": "unsafe-write-boundary"}}}]},
    "budget-stop": {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"check_id": {"const": "budget-stop"}}}]}
  }
}
