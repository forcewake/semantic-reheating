{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semantic-reheating.dev/contracts/v1/recovery-outcome.schema.json",
  "title": "RecoveryOutcome",
  "description": "Closed host-reported recovery outcome.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "1.0",
      "description": "Pinned public contract version."
    },
    "run_id": {
      "type": "string",
      "description": "Public run identifier.",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "outcome_id": {
      "type": "string",
      "description": "Public outcome identifier.",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "instruction_id": {
      "type": "string",
      "description": "Public instruction identifier.",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "host_result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "partial",
            "failed",
            "denied",
            "escalated"
          ],
          "description": "Closed host result status."
        },
        "summary": {
          "type": "string",
          "description": "Redacted host result summary.",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "status",
        "summary"
      ],
      "description": "Closed host result."
    },
    "consumed_counters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "turns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000,
          "description": "Turn count."
        },
        "tool_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000,
          "description": "Tool-call count."
        },
        "tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000,
          "description": "Token count."
        },
        "elapsed_seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 31536000,
          "description": "Elapsed seconds."
        },
        "cost": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000,
          "description": "Public cost units."
        }
      },
      "required": [
        "turns",
        "tool_calls",
        "tokens",
        "elapsed_seconds",
        "cost"
      ],
      "description": "Complete consumed resource counters."
    },
    "evidence_gained": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "Public evidence reference.",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      },
      "minItems": 0,
      "maxItems": 1000,
      "uniqueItems": true,
      "description": "Evidence gained."
    },
    "acceptance_delta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "improved",
            "unchanged",
            "regressed",
            "unknown"
          ],
          "description": "Acceptance change status."
        },
        "summary": {
          "type": "string",
          "description": "Redacted acceptance delta.",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "status",
        "summary"
      ],
      "description": "Closed acceptance delta."
    },
    "state_delta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "observed": {
          "type": "boolean",
          "description": "Whether state change was observed."
        },
        "summary": {
          "type": "string",
          "description": "Redacted state delta.",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "observed",
        "summary"
      ],
      "description": "Closed state delta."
    },
    "error_class": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "tool_failure",
        "validation_failure",
        "budget_exhausted",
        "host_denial",
        "risk_blocker",
        null
      ],
      "description": "Closed error class or null."
    },
    "host_denial": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "denied": {
          "type": "boolean",
          "description": "Whether the host denied action."
        },
        "reason_code": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "not_authorized",
            "not_confirmed",
            "policy_blocked",
            null
          ],
          "description": "Closed host denial reason or null."
        }
      },
      "required": [
        "denied",
        "reason_code"
      ],
      "description": "Closed host denial record."
    },
    "human_escalation": {
      "type": "boolean",
      "description": "Whether human escalation occurred."
    }
  },
  "required": [
    "contract_version",
    "run_id",
    "outcome_id",
    "instruction_id",
    "host_result",
    "consumed_counters",
    "evidence_gained",
    "acceptance_delta",
    "state_delta",
    "error_class",
    "host_denial",
    "human_escalation"
  ]
}
