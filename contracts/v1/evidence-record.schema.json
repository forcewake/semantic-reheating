{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semantic-reheating.dev/contracts/v1/evidence-record.schema.json",
  "title": "EvidenceRecord",
  "description": "Closed public recovery evidence record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "1.0",
      "description": "Pinned public contract version."
    },
    "run_id": {
      "type": "string",
      "description": "Public run identifier.",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "evidence_id": {
      "type": "string",
      "description": "Public evidence identifier.",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "finding_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "Public finding identifier.",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "description": "Trigger finding identifiers."
        },
        "reason_code": {
          "type": "string",
          "enum": [
            "signals_agree",
            "risk_detected",
            "budget_limit_reached",
            "host_request"
          ],
          "description": "Stable trigger code."
        }
      },
      "required": [
        "finding_ids",
        "reason_code"
      ],
      "description": "Closed recovery trigger."
    },
    "chosen_policy": {
      "type": "string",
      "enum": [
        "policy-standard",
        "policy-conservative"
      ],
      "description": "Closed chosen policy identifier."
    },
    "actual_counters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "turns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000,
          "description": "Turn count."
        },
        "tool_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000,
          "description": "Tool-call count."
        },
        "tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000,
          "description": "Token count."
        },
        "elapsed_seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 31536000,
          "description": "Elapsed seconds."
        },
        "cost": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000,
          "description": "Public cost units."
        }
      },
      "required": [
        "turns",
        "tool_calls",
        "tokens",
        "elapsed_seconds",
        "cost"
      ],
      "description": "Complete actual resource counters."
    },
    "new_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "Public evidence reference.",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      },
      "minItems": 0,
      "maxItems": 1000,
      "uniqueItems": true,
      "description": "New public evidence references."
    },
    "acceptance_delta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "improved",
            "unchanged",
            "regressed",
            "unknown"
          ],
          "description": "Acceptance change status."
        },
        "summary": {
          "type": "string",
          "description": "Redacted acceptance delta.",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "status",
        "summary"
      ],
      "description": "Closed acceptance delta."
    },
    "repeated_side_effects_avoided": {
      "type": "boolean",
      "description": "Whether repeated side effects were avoided."
    },
    "final_status": {
      "type": "string",
      "enum": [
        "continued",
        "recovered",
        "stopped",
        "escalated",
        "blocked"
      ],
      "description": "Closed final status."
    }
  },
  "required": [
    "contract_version",
    "run_id",
    "evidence_id",
    "trigger",
    "chosen_policy",
    "actual_counters",
    "new_evidence_refs",
    "acceptance_delta",
    "repeated_side_effects_avoided",
    "final_status"
  ]
}
