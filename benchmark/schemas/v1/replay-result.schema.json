{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semantic-reheating.dev/benchmark/schemas/v1/replay-result.schema.json",
  "title": "Deterministic replay result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "corpus_version",
    "corpus_revision",
    "policy_sha256",
    "tool",
    "deterministic_replay",
    "metrics",
    "traces"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "corpus_version": {
      "const": "1.0"
    },
    "corpus_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "command"
      ],
      "properties": {
        "name": {
          "const": "semantic-reheating"
        },
        "version": {
          "const": "0.1.0"
        },
        "command": {
          "const": [
            "benchmark",
            "benchmark/corpus",
            "--manifest",
            "benchmark/scenarios/manifest.json",
            "--format",
            "json"
          ]
        }
      }
    },
    "deterministic_replay": {
      "type": "boolean"
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "detector_confusion",
        "detector_precision",
        "detector_recall",
        "decision_correct",
        "decision_total",
        "decision_accuracy",
        "false_interventions",
        "productive_controls",
        "false_intervention_rate",
        "evidence_matches",
        "safety_matches"
      ],
      "properties": {
        "detector_confusion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "exact_repetition",
            "cycle",
            "repeated_error",
            "unchanged_state",
            "acceptance_stall",
            "budget_burn",
            "hard_budget",
            "repeated_risky_call"
          ],
          "properties": {
            "exact_repetition": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "tp",
                "fp",
                "fn",
                "tn"
              ],
              "properties": {
                "tp": {
                  "type": "integer",
                  "minimum": 0
                },
                "fp": {
                  "type": "integer",
                  "minimum": 0
                },
                "fn": {
                  "type": "integer",
                  "minimum": 0
                },
                "tn": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "cycle": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "tp",
                "fp",
                "fn",
                "tn"
              ],
              "properties": {
                "tp": {
                  "type": "integer",
                  "minimum": 0
                },
                "fp": {
                  "type": "integer",
                  "minimum": 0
                },
                "fn": {
                  "type": "integer",
                  "minimum": 0
                },
                "tn": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "repeated_error": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "tp",
                "fp",
                "fn",
                "tn"
              ],
              "properties": {
                "tp": {
                  "type": "integer",
                  "minimum": 0
                },
                "fp": {
                  "type": "integer",
                  "minimum": 0
                },
                "fn": {
                  "type": "integer",
                  "minimum": 0
                },
                "tn": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "unchanged_state": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "tp",
                "fp",
                "fn",
                "tn"
              ],
              "properties": {
                "tp": {
                  "type": "integer",
                  "minimum": 0
                },
                "fp": {
                  "type": "integer",
                  "minimum": 0
                },
                "fn": {
                  "type": "integer",
                  "minimum": 0
                },
                "tn": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "acceptance_stall": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "tp",
                "fp",
                "fn",
                "tn"
              ],
              "properties": {
                "tp": {
                  "type": "integer",
                  "minimum": 0
                },
                "fp": {
                  "type": "integer",
                  "minimum": 0
                },
                "fn": {
                  "type": "integer",
                  "minimum": 0
                },
                "tn": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "budget_burn": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "tp",
                "fp",
                "fn",
                "tn"
              ],
              "properties": {
                "tp": {
                  "type": "integer",
                  "minimum": 0
                },
                "fp": {
                  "type": "integer",
                  "minimum": 0
                },
                "fn": {
                  "type": "integer",
                  "minimum": 0
                },
                "tn": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "hard_budget": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "tp",
                "fp",
                "fn",
                "tn"
              ],
              "properties": {
                "tp": {
                  "type": "integer",
                  "minimum": 0
                },
                "fp": {
                  "type": "integer",
                  "minimum": 0
                },
                "fn": {
                  "type": "integer",
                  "minimum": 0
                },
                "tn": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "repeated_risky_call": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "tp",
                "fp",
                "fn",
                "tn"
              ],
              "properties": {
                "tp": {
                  "type": "integer",
                  "minimum": 0
                },
                "fp": {
                  "type": "integer",
                  "minimum": 0
                },
                "fn": {
                  "type": "integer",
                  "minimum": 0
                },
                "tn": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        },
        "detector_precision": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "numerator",
            "denominator",
            "value"
          ],
          "properties": {
            "numerator": {
              "type": "integer",
              "minimum": 0
            },
            "denominator": {
              "type": "integer",
              "minimum": 1
            },
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "detector_recall": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "numerator",
            "denominator",
            "value"
          ],
          "properties": {
            "numerator": {
              "type": "integer",
              "minimum": 0
            },
            "denominator": {
              "type": "integer",
              "minimum": 1
            },
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "decision_correct": {
          "type": "integer",
          "minimum": 0
        },
        "decision_total": {
          "type": "integer",
          "minimum": 1
        },
        "decision_accuracy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "numerator",
            "denominator",
            "value"
          ],
          "properties": {
            "numerator": {
              "type": "integer",
              "minimum": 0
            },
            "denominator": {
              "type": "integer",
              "minimum": 1
            },
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "false_interventions": {
          "type": "integer",
          "minimum": 0
        },
        "productive_controls": {
          "type": "integer",
          "minimum": 1
        },
        "false_intervention_rate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "numerator",
            "denominator",
            "value"
          ],
          "properties": {
            "numerator": {
              "type": "integer",
              "minimum": 0
            },
            "denominator": {
              "type": "integer",
              "minimum": 1
            },
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "evidence_matches": {
          "type": "integer",
          "minimum": 0
        },
        "safety_matches": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "traces": {
      "type": "array",
      "minItems": 24,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario_id",
          "label",
          "trace_sha256",
          "expected_detector_names",
          "actual_detector_names",
          "detector_missing_names",
          "detector_unexpected_names",
          "detectors_match",
          "expected_decision",
          "actual_decision",
          "decision_match",
          "expected_evidence_event_ids",
          "actual_evidence_event_ids",
          "evidence_missing_event_ids",
          "evidence_unexpected_event_ids",
          "evidence_match",
          "expected_safety_outcome",
          "actual_safety_outcome",
          "safety_match",
          "decision_record",
          "decision_sha256"
        ],
        "properties": {
          "scenario_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "label": {
            "enum": [
              "pathological",
              "productive_control"
            ]
          },
          "trace_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "expected_detector_names": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "exact_repetition",
                "cycle",
                "repeated_error",
                "unchanged_state",
                "acceptance_stall",
                "budget_burn",
                "hard_budget",
                "repeated_risky_call"
              ]
            }
          },
          "actual_detector_names": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "exact_repetition",
                "cycle",
                "repeated_error",
                "unchanged_state",
                "acceptance_stall",
                "budget_burn",
                "hard_budget",
                "repeated_risky_call"
              ]
            }
          },
          "detector_missing_names": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "exact_repetition",
                "cycle",
                "repeated_error",
                "unchanged_state",
                "acceptance_stall",
                "budget_burn",
                "hard_budget",
                "repeated_risky_call"
              ]
            }
          },
          "detector_unexpected_names": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "exact_repetition",
                "cycle",
                "repeated_error",
                "unchanged_state",
                "acceptance_stall",
                "budget_burn",
                "hard_budget",
                "repeated_risky_call"
              ]
            }
          },
          "detectors_match": {
            "type": "boolean"
          },
          "expected_decision": {
            "enum": [
              "continue",
              "nudge",
              "diagnose",
              "reheat",
              "restart",
              "escalate",
              "stop"
            ]
          },
          "actual_decision": {
            "enum": [
              "continue",
              "nudge",
              "diagnose",
              "reheat",
              "restart",
              "escalate",
              "stop"
            ]
          },
          "decision_match": {
            "type": "boolean"
          },
          "expected_evidence_event_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^event-[0-9]{3}$"
            }
          },
          "actual_evidence_event_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            }
          },
          "evidence_missing_event_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^event-[0-9]{3}$"
            }
          },
          "evidence_unexpected_event_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            }
          },
          "evidence_match": {
            "type": "boolean"
          },
          "expected_safety_outcome": {
            "enum": [
              "safe_continue",
              "advisory_continue",
              "recovery",
              "escalated",
              "hard_stop"
            ]
          },
          "actual_safety_outcome": {
            "enum": [
              "safe_continue",
              "advisory_continue",
              "recovery",
              "escalated",
              "hard_stop"
            ]
          },
          "safety_match": {
            "type": "boolean"
          },
          "decision_record": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "contract_version": {
                "const": "1.0",
                "description": "Pinned public contract version."
              },
              "run_id": {
                "type": "string",
                "description": "Public run identifier.",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              },
              "decision_id": {
                "type": "string",
                "description": "Public decision identifier.",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              },
              "decision": {
                "type": "string",
                "enum": [
                  "continue",
                  "nudge",
                  "diagnose",
                  "reheat",
                  "restart",
                  "escalate",
                  "stop"
                ],
                "description": "Exact closed decision."
              },
              "reason_codes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "signals_agree",
                    "repetition_detected",
                    "no_progress_detected",
                    "risk_detected",
                    "budget_limit_reached",
                    "cooling_active",
                    "host_action_required"
                  ]
                },
                "minItems": 0,
                "maxItems": 16,
                "uniqueItems": true,
                "description": "Stable decision reason codes."
              },
              "evidence_event_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "Public evidence event identifier.",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                },
                "minItems": 0,
                "maxItems": 1000,
                "uniqueItems": true,
                "description": "Evidence event identifiers."
              },
              "recovery_policy": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "policy-standard",
                  "policy-conservative",
                  "research",
                  "branch",
                  "model_switch",
                  null
                ],
                "description": "Closed recovery policy identifier or null."
              },
              "recovery_budget": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "turns": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000,
                    "description": "Turn count."
                  },
                  "tool_calls": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000,
                    "description": "Tool-call count."
                  },
                  "tokens": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000000,
                    "description": "Token count."
                  },
                  "elapsed_seconds": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 31536000,
                    "description": "Elapsed seconds."
                  },
                  "cost": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1000000000,
                    "description": "Public cost units."
                  }
                },
                "required": [
                  "turns",
                  "tool_calls",
                  "tokens",
                  "elapsed_seconds",
                  "cost"
                ],
                "description": "Complete decision recovery budget."
              },
              "constraints": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "must_preserve_evidence": {
                    "type": "boolean",
                    "description": "Evidence must be preserved."
                  },
                  "no_non_idempotent_repeat": {
                    "const": true,
                    "description": "Non-idempotent repeat is prohibited."
                  },
                  "require_host_confirmation": {
                    "type": "boolean",
                    "description": "Host confirmation requirement."
                  },
                  "allowed_effect_classes": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "read_only",
                        "idempotent_write"
                      ]
                    },
                    "maxItems": 2,
                    "uniqueItems": true,
                    "description": "Permitted effect classes."
                  }
                },
                "required": [
                  "must_preserve_evidence",
                  "no_non_idempotent_repeat",
                  "require_host_confirmation",
                  "allowed_effect_classes"
                ],
                "description": "Closed decision constraints."
              },
              "cooling_conditions": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "minimum_elapsed_seconds": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 31536000,
                    "description": "Required cooling time."
                  },
                  "require_new_evidence": {
                    "type": "boolean",
                    "description": "Whether new evidence is required."
                  },
                  "minimum_acceptance_gain": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "Required acceptance gain."
                  }
                },
                "required": [
                  "minimum_elapsed_seconds",
                  "require_new_evidence",
                  "minimum_acceptance_gain"
                ],
                "description": "Closed decision cooling conditions."
              },
              "confidence": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "score": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "Bounded decision confidence."
                  },
                  "contributing_findings": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "finding_id": {
                          "type": "string",
                          "description": "Public finding identifier.",
                          "minLength": 1,
                          "maxLength": 128,
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                        },
                        "finding_class": {
                          "type": "string",
                          "enum": [
                            "repetition",
                            "no_progress",
                            "risk",
                            "budget"
                          ],
                          "description": "Closed finding class."
                        },
                        "matched": {
                          "type": "boolean",
                          "description": "Whether the finding matched."
                        },
                        "score": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1,
                          "description": "Bounded finding score."
                        },
                        "weight": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1,
                          "description": "Configured class weight used for this finding."
                        },
                        "weighted_score": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1,
                          "description": "Clipped product of the raw score and configured weight."
                        }
                      },
                      "required": [
                        "finding_id",
                        "finding_class",
                        "matched",
                        "score",
                        "weight",
                        "weighted_score"
                      ],
                      "description": "Redacted contributing finding record."
                    },
                    "minItems": 0,
                    "maxItems": 100,
                    "description": "Closed contributing finding records."
                  }
                },
                "required": [
                  "score",
                  "contributing_findings"
                ],
                "description": "Closed confidence record."
              },
              "requires_host_action": {
                "type": "boolean",
                "description": "Whether host action is required."
              },
              "human_summary": {
                "type": "string",
                "description": "Redacted public human summary.",
                "minLength": 1,
                "maxLength": 2000
              },
              "diagnosed_gaps": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "missing_evidence",
                        "ambiguous_goal",
                        "failed_acceptance",
                        "stalled_progress",
                        "risk_blocker"
                      ]
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    }
                  },
                  "required": [
                    "kind",
                    "description"
                  ]
                },
                "minItems": 0,
                "maxItems": 16,
                "description": "Closed portable diagnosed recovery gaps."
              },
              "rejected_hypothesis_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^rejected-hypothesis-[0-9a-f]{24}$"
                },
                "minItems": 0,
                "maxItems": 100,
                "uniqueItems": true,
                "description": "Redacted rejected-hypothesis references."
              },
              "detector_notices": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "detector_name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "degraded",
                        "unavailable"
                      ]
                    },
                    "notice": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    }
                  },
                  "required": [
                    "detector_name",
                    "status",
                    "notice"
                  ]
                },
                "minItems": 0,
                "maxItems": 16,
                "uniqueItems": true,
                "description": "Structured fixed redacted detector availability notices."
              }
            },
            "required": [
              "contract_version",
              "run_id",
              "decision_id",
              "decision",
              "reason_codes",
              "evidence_event_ids",
              "recovery_policy",
              "recovery_budget",
              "constraints",
              "cooling_conditions",
              "confidence",
              "requires_host_action",
              "human_summary",
              "diagnosed_gaps",
              "rejected_hypothesis_refs",
              "detector_notices"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "decision": {
                      "const": "escalate"
                    }
                  },
                  "required": [
                    "decision"
                  ]
                },
                "then": {
                  "properties": {
                    "requires_host_action": {
                      "const": true
                    }
                  }
                }
              }
            ]
          },
          "decision_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
